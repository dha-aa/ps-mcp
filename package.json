{
  "name": "photoshop-mcp",
  "version": "0.5.6",
  "description": "MCP server that drives a live Adobe Photoshop through a UXP plugin",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "photoshop-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:server && npm run build:plugin",
    "build:server": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "build:plugin": "node node_modules/typescript/bin/tsc -p tsconfig.plugin.json && node scripts/build-plugin.ts",
    "clean": "node -e \"for (const d of ['dist','build','plugin/js']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.plugin.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.ts",
    "check-api": "node scripts/check-api.ts",
    "package": "node scripts/package-plugin.ts",
    "live": "node test/live.ts --yes"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "image-size": "^2.0.4",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
